{
  "manifest_version": 2,
  "name": "Spider Data By Html",
  "version": "1.0",
  "description": "A Chrome extension to extract data by html with GPT",
  "permissions": ["<all_urls>", "storage"],
  "browser_action": {
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "scripts": ["background/background.js"],
    "persistent": true
  }
}
